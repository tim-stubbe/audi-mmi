+        // Carlinkit ships the same CPC200 hardware with product IDs across
+        // the 0x1520..0x152f family. Keep the configured ID as the preferred
+        // match, then accept another member of that family so an OTA update
+        // does not depend on the exact dongle revision.
+        if (!handler)
+        {
+            libusb_device **devices = nullptr;
+            ssize_t count = libusb_get_device_list(_context, &devices);
+            for (ssize_t i = 0; i < count && !handler; ++i)
+            {
+                libusb_device_descriptor descriptor{};
+                if (libusb_get_device_descriptor(devices[i], &descriptor) == 0 &&
+                    descriptor.idVendor == Settings::vendorid.value &&
+                    (descriptor.idProduct & 0xfff0) == (Settings::productid.value & 0xfff0))
+                    libusb_open(devices[i], &handler);
+            }
+            if (devices)
+                libusb_free_device_list(devices, 1);
+        }
