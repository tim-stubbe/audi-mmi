[Unit]
Description=Check for or install a tested Audi MMI application update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=AUDI_MMI_SKIP_KIOSK_RESTART=1
ExecStart=/usr/bin/python3 /opt/audi-mmi/bin/audi-mmi-updater.py --check
Nice=10
IOSchedulingClass=idle
