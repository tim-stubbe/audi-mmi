[Unit]
Description=Audi MMI kiosk (cage + native launcher / CarPlay)
After=systemd-user-sessions.service getty@tty1.service seatd.service
Conflicts=getty@tty1.service

[Service]
Type=simple
# Existing installations need one self-contained migration pass: install the
# native client's runtime libraries, then let the newly installed updater copy
# the FastCarPlay payload before the kiosk starts. On later boots this is a
# single executable check and performs no network or package operation.
ExecStartPre=+/bin/sh -c 'if [ ! -x /opt/audi-mmi/fastcarplay/fastcarplay ]; then apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends libsdl2-2.0-0 libsdl2-ttf-2.0-0 libavformat61 libavcodec61 libavutil59 libswscale8 libusb-1.0-0 libssl3t64 && AUDI_MMI_SKIP_KIOSK_RESTART=1 /usr/bin/python3 /opt/audi-mmi/bin/audi-mmi-updater.py --install; fi'
# Limit passwordless elevation to the two service actions used by the update UI.
# This ExecStartPre also migrates installations made from older images.
ExecStartPre=+/bin/sh -c 'u=$$(getent passwd 1000 | cut -d: -f1); printf "%s ALL=(root) NOPASSWD: /usr/bin/systemctl restart audi-mmi-update.service, /usr/bin/systemctl restart audi-mmi-kiosk.service\n" "$$u" > /etc/sudoers.d/011-audi-mmi-update; chmod 0440 /etc/sudoers.d/011-audi-mmi-update'
ExecStart=/opt/audi-mmi/bin/kiosk-runner.sh
User=1000
SupplementaryGroups=input video render plugdev
RuntimeDirectory=audi-mmi
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/audi-mmi
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=2
UtmpIdentifier=tty1
UtmpMode=user

[Install]
WantedBy=multi-user.target
